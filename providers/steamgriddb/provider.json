{
  "id": "steamgriddb",
  "name": "SteamGridDB",
  "kind": "metadata",
  "apiVersion": "v1",
  "entry": "index.js",
  "capabilities": {
    "http": {
      "hosts": [
        "www.steamgriddb.com"
      ]
    }
  },
  "provides": [
    "cover",
    "background",
    "logo"
  ],
  "settings": [
    {
      "key": "apiKey",
      "label": "SteamGridDB API key",
      "type": "secret",
      "required": true,
      "secret": true,
      "help": "Generate a key at https://www.steamgriddb.com/profile/preferences/api"
    }
  ],
  "presentation": {
    "icon": "assets/icon.png",
    "cover": "assets/cover.png"
  }
}
